    "While closed Ports only scans sockets (no CPU sampling, no probes; containers at most every 15 s). Scanning pauses while the Mac sleeps or the screen is locked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While closed Ports only scans sockets (no CPU sampling, no probes; containers at most every 15 s). Scanning pauses while the Mac sleeps or the screen is locked."
          }
        }
      }
    },
